        <mxCell id="a6" value="shared controls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#6B432C;strokeWidth=2;fontSize=13;fontColor=#76675A;" edge="1" parent="1" source="cross" target="modules">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="read / write data" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#6B432C;strokeWidth=2;fontSize=13;fontColor=#76675A;" edge="1" parent="1" source="modules" target="data">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a8" value="SQL queries" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#6B432C;strokeWidth=2;fontSize=13;fontColor=#76675A;" edge="1" parent="1" source="data" target="sqlite">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a9" value="validated upload" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;strokeColor=#63734B;strokeWidth=2;fontSize=12;fontColor=#63734B;" edge="1" parent="1" source="cross" target="files">
          <mxGeometry relative="1" as="geometry" />
