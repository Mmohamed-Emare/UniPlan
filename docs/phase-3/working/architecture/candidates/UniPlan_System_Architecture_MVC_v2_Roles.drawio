        <mxCell id="a5" value="permitted request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#6B432C;strokeWidth=2;fontSize=13;fontColor=#76675A;" edge="1" parent="1" source="controllers" target="modules">
          <mxGeometry relative="1" as="geometry" />
