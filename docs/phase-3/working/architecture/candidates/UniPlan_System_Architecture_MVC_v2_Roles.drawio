        <mxCell id="ct" value="&lt;b&gt;ASSIGNMENT ROUTE / CONTROLLER&lt;/b&gt;&lt;br&gt;Check session, role, assignment ownership, and course scope&lt;br&gt;Student: own submission • TA/Instructor: assigned course only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1DCC8;strokeColor=#C99A53;fontColor=#3F3027;fontSize=15;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="510" y="180" width="580" height="100" as="geometry" />
        </mxCell>
        <mxCell id="svc" value="&lt;b&gt;ASSIGNMENT SUBMISSION SERVICE&lt;/b&gt;&lt;br&gt;Validate submission data • apply current resubmission rule" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EBD9;strokeColor=#7E8058;fontColor=#3F3027;fontSize=15;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="510" y="335" width="580" height="100" as="geometry" />
        </mxCell>
        <mxCell id="decision" value="FILE&lt;br&gt;ATTACHED?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F8EBDD;strokeColor=#C99A53;fontColor=#3F3027;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="710" y="485" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="validation" value="&lt;b&gt;UPLOAD VALIDATION&lt;/b&gt;&lt;br&gt;Allowed type • size • safe filename" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9F1;strokeColor=#B97852;fontColor=#3F3027;fontSize=15;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="665" width="380" height="95" as="geometry" />
        </mxCell>
        <mxCell id="disk" value="&lt;b&gt;LOCAL FILE STORAGE&lt;/b&gt;&lt;br&gt;Actual file saved outside SQLite" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9F1;strokeColor=#B97852;fontColor=#3F3027;fontSize=15;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="815" width="380" height="95" as="geometry" />
        </mxCell>
        <mxCell id="textonly" value="&lt;b&gt;TEXT-ONLY SUBMISSION&lt;/b&gt;&lt;br&gt;No file path required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1DCC8;strokeColor=#C99A53;fontColor=#3F3027;fontSize=15;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="970" y="665" width="380" height="95" as="geometry" />
