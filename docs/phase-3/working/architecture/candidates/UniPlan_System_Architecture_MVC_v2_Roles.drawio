        <mxCell id="record" value="&lt;b&gt;ASSIGNMENT_SUBMISSION RECORD&lt;/b&gt;&lt;br&gt;Student • Assignment • Text / file path&lt;br&gt;Submitted time • Status • Optional score / feedback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EBD9;strokeColor=#7E8058;fontColor=#3F3027;fontSize=15;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
