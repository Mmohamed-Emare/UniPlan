  <diagram id="system" name="01 System Architecture">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1340" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="student" value="&lt;b&gt;STUDENT&lt;/b&gt;&lt;br&gt;Academic &amp;amp; planning features" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAD8C2;strokeColor=#C99A53;fontColor=#4B2E20;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="180" y="35" width="260" height="85" as="geometry" />
        </mxCell>
        <mxCell id="admin" value="&lt;b&gt;ADMINISTRATOR&lt;/b&gt;&lt;br&gt;Manage simulated data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAD8C2;strokeColor=#C99A53;fontColor=#4B2E20;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1120" y="35" width="300" height="85" as="geometry" />
        </mxCell>
        <mxCell id="browser" value="&lt;b&gt;CLIENT / WEB BROWSER&lt;/b&gt;&lt;br&gt;&lt;br&gt;Single Login • Student UI • Teaching Staff UI • Administrator UI&lt;br&gt;Jinja / HTML templates • CSS • JavaScript" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9F1;strokeColor=#B97852;fontColor=#3F3027;fontSize=15;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="390" y="165" width="780" height="130" as="geometry" />
        </mxCell>
        <mxCell id="controllers" value="&lt;b&gt;FLASK ROUTES &amp;amp; CONTROLLERS&lt;/b&gt;&lt;br&gt;Receive requests • Read authenticated role from session&lt;br&gt;Authorize route + record ownership • Validate inputs&lt;br&gt;Call module services • Return rendered HTML" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1DCC8;strokeColor=#C99A53;fontColor=#3F3027;fontSize=15;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="465" y="365" width="700" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cross" value="&lt;b&gt;SHARED SERVICES&lt;/b&gt;&lt;br&gt;Authentication &amp;amp; sessions&lt;br&gt;Role authorization • Validation&lt;br&gt;Upload checks • Error handling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9F1;strokeColor=#B97852;fontColor=#3F3027;fontSize=15;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="555" width="350" height="155" as="geometry" />
        </mxCell>
        <mxCell id="modules" value="&lt;b&gt;MODULE BUSINESS SERVICES&lt;/b&gt;&lt;br&gt;&lt;br&gt;Academic Experience&lt;br&gt;Smart Academic Planning&lt;br&gt;Personal Growth &amp;amp; Productivity&lt;br&gt;GPA Calculation • Assignment Submission" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EBD9;strokeColor=#7E8058;fontColor=#3F3027;fontSize=15;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="545" y="545" width="530" height="190" as="geometry" />
        </mxCell>
        <mxCell id="ai" value="&lt;b&gt;AI STUDY LAB&lt;/b&gt;&lt;br&gt;&lt;br&gt;Planned / later implementation&lt;br&gt;Provider not selected&lt;br&gt;No live AI integration assumed" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5E4D8;strokeColor=#B97852;fontColor=#3F3027;fontSize=14;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1120" y="555" width="350" height="155" as="geometry" />
        </mxCell>
        <mxCell id="data" value="&lt;b&gt;DATA ACCESS / MODEL LAYER&lt;/b&gt;&lt;br&gt;&lt;br&gt;Domain models • Repositories / query functions&lt;br&gt;CRUD operations • Data integrity rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1DCC8;strokeColor=#C99A53;fontColor=#3F3027;fontSize=15;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="465" y="785" width="700" height="110" as="geometry" />
        </mxCell>
        <mxCell id="sqlite" value="&lt;b&gt;SQLITE DATABASE&lt;/b&gt;&lt;br&gt;25 entities • local DB file" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#E0E7D5;strokeColor=#7E8058;fontColor=#3F3027;fontSize=15;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="350" y="1010" width="340" height="115" as="geometry" />
        </mxCell>
        <mxCell id="files" value="&lt;b&gt;LOCAL FILE STORAGE&lt;/b&gt;&lt;br&gt;Uploaded files outside SQLite&lt;br&gt;DB stores path + metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9F1;strokeColor=#B97852;fontColor=#3F3027;fontSize=15;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="890" y="1010" width="420" height="115" as="geometry" />
        </mxCell>
        <mxCell id="scope" value="&lt;b&gt;SCOPE BOUNDARIES&lt;/b&gt;&lt;br&gt;Generic / simulated academic data • No live university integration&lt;br&gt;AI Study Lab is planned; provider and integration remain undecided.&lt;br&gt;All active modules share one Flask application and SQLite database." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#C9B18F;fontColor=#76675A;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="250" y="1170" width="1080" height="105" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#6B432C;strokeWidth=2;fontSize=13;fontColor=#76675A;" edge="1" parent="1" source="student" target="browser">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#6B432C;strokeWidth=2;fontSize=13;fontColor=#76675A;" edge="1" parent="1" source="admin" target="browser">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="request / form data" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#6B432C;strokeWidth=2;fontSize=13;fontColor=#76675A;" edge="1" parent="1" source="browser" target="controllers">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="authenticate / validate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#6B432C;strokeWidth=2;fontSize=13;fontColor=#76675A;" edge="1" parent="1" source="controllers" target="cross">
          <mxGeometry relative="1" as="geometry" />
