  <diagram id="submission" name="04 Assignment Submission Flow">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1640" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="st" value="&lt;b&gt;STUDENT BROWSER&lt;/b&gt;&lt;br&gt;Submits assignment text and optional file" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAD8C2;strokeColor=#C99A53;fontColor=#4B2E20;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="40" width="480" height="85" as="geometry" />
