        <mxCell id="title1" value="&lt;b&gt;UniPlan UML Class Diagram — 01 - Identity &amp; Academic Core&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#52657A&quot;&gt;Core identity, course catalogue, prerequisites, course history, role-scoped staff access.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontColor=#183B56;" vertex="1" parent="1">
