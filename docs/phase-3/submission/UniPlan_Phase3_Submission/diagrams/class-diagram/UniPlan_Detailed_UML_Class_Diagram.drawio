        <mxCell id="p2_c3" value="&lt;b&gt;Section&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;- sectionId: INTEGER&lt;br/&gt;- courseId: INTEGER&lt;br/&gt;- semesterId: INTEGER&lt;br/&gt;- sectionCode: TEXT&lt;br/&gt;&lt;hr/&gt;&lt;font color=&quot;#52657A&quot;&gt;+ containsAssignment()&lt;/font&gt;" style="swimlane;startSize=28;horizontal=1;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;swimlaneFillColor=#DCEAF5;strokeColor=#3A6384;fontColor=#183B56;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="500" y="80" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p2_c4" value="&lt;b&gt;Assignment&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;- assignmentId: INTEGER&lt;br/&gt;- sectionId: INTEGER&lt;br/&gt;- createdBy: INTEGER&lt;br/&gt;- title: TEXT&lt;br/&gt;- dueAt: DATETIME&lt;br/&gt;- allowedFileTypes: TEXT&lt;br/&gt;- maxFileSizeMb: INTEGER&lt;br/&gt;- allowResubmission: BOOLEAN&lt;br/&gt;&lt;hr/&gt;&lt;font color=&quot;#52657A&quot;&gt;+ validateSubmissionPolicy()&lt;/font&gt;" style="swimlane;startSize=28;horizontal=1;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;swimlaneFillColor=#DCEAF5;strokeColor=#3A6384;fontColor=#183B56;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="930" y="150" width="300" height="220" as="geometry" />
        </mxCell>
        <mxCell id="p2_c5" value="&lt;b&gt;AssignmentSubmission&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;- submissionId: INTEGER&lt;br/&gt;- assignmentId: INTEGER&lt;br/&gt;- studentId: INTEGER&lt;br/&gt;- versionNumber: INTEGER&lt;br/&gt;- filePath: TEXT&lt;br/&gt;- originalFilename: TEXT&lt;br/&gt;- fileSizeBytes: INTEGER&lt;br/&gt;- mimeType: TEXT&lt;br/&gt;- submittedAt: DATETIME&lt;br/&gt;- receiptCode: TEXT&lt;br/&gt;- receiptStatus: RECEIVED&lt;br/&gt;&lt;hr/&gt;&lt;font color=&quot;#52657A&quot;&gt;+ issueReceipt()&lt;br/&gt;+ nextVersionNumber()&lt;/font&gt;" style="swimlane;startSize=28;horizontal=1;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;swimlaneFillColor=#DCEAF5;strokeColor=#3A6384;fontColor=#183B56;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1400" y="250" width="300" height="300" as="geometry" />
        </mxCell>
        <mxCell id="p2_e1" value="1 — briefs — 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#526D82;fontColor=#526D82;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=none;startArrow=none;" edge="1" parent="1" source="p2_c3" target="p2_c4">
