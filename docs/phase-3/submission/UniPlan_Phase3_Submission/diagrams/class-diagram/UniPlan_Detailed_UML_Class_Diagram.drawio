        </mxCell>
        <mxCell id="p2_e2" value="1 — creates — 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#526D82;fontColor=#526D82;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=none;startArrow=none;" edge="1" parent="1" source="p2_c1" target="p2_c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_e3" value="1 — accepted versions — 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#526D82;fontColor=#526D82;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=none;startArrow=none;" edge="1" parent="1" source="p2_c4" target="p2_c5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_e4" value="1 — submits — 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#526D82;fontColor=#526D82;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=none;startArrow=none;" edge="1" parent="1" source="p2_c2" target="p2_c5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="&lt;b&gt;Design note:&lt;/b&gt; Each accepted upload is one immutable version row with a server-generated UTC timestamp and unique receipt. Validate student ownership, course-scoped staff access, deadline, type, size and resubmission rule. There is no assignment grading, score or grader feedback." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8FB;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
