        <mxCell id="p5_e6" value="1 — optional task — 0..* (same owner)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#526D82;fontColor=#526D82;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=none;startArrow=none;" edge="1" parent="1" source="p5_c4" target="p5_c5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note5" value="&lt;b&gt;Design note:&lt;/b&gt; H-07 rule: PERSONAL_TASK has no plan_id. STUDY_SESSION must belong to exactly one STUDY_PLAN. If a session references a task, both must have the same student owner. Completing a session does not automatically complete the task. Enum differences between the Addendum and SQL are flagged in the document for final SRS alignment." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8FB;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1060" width="1760" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
