        <mxCell id="p1_e11" value="1 — assigned staff — 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#526D82;fontColor=#526D82;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=none;startArrow=none;" edge="1" parent="1" source="p1_c3" target="p1_c9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note1" value="&lt;b&gt;Design note:&lt;/b&gt; Prerequisite rule: every listed prerequisite must have at least one PASSED completion attempt in any semester. A previous FAILED attempt does not invalidate a later PASS. Seat availability is simulated as capacity − enrolledCount. TA/Instructor course access requires an ACTIVE course assignment." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8FB;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
